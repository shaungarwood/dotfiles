// -*- mode: json -*-

{
	"layer": "top",
	"position": "top",
	"margin-top": 6,
	"margin-left": 10,
	"margin-right": 10,
	"margin-bottom": 3,
	"spacing": 3,

	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"pulseaudio",
		"network",
		"cpu",
		"memory",
		"custom/temp",
		"battery",
		"tray"
	],

	"sway/workspaces": {
		"disable-scroll": true,
		"all-outputs": true,
		"format": "{value}"
	},

	"sway/mode": {
		"format": "󰩨 {}",
		"tooltip": false
	},

	"clock": {
		"interval": 1,
		"timezone": "America/Denver",
		"format": "{:󰃭 %a %b %d  󰅐 %H:%M}",
		"format-alt": "{:󰅐 %H:%M:%S  󰃭 %Y-%m-%d}",
		"tooltip-format": "<tt><small>{calendar}</small></tt>"
	},

	"pulseaudio": {
		"format": "{icon} {volume}%",
		"format-bluetooth": "{icon}󰂰 {volume}%",
		"format-bluetooth-muted": "󰝟󰂰",
		"format-muted": "󰝟 Muted",
		"format-icons": {
			"headphone": "󰋋",
			"hands-free": "󰋋",
			"headset": "󰋋",
			"phone": "󰏲",
			"portable": "󰏲",
			"car": "󰄋",
			"default": ["󰕿", "󰖀", "󰕾"]
		},
		"scroll-step": 5,
		"on-click": "pamixer -t",
		"on-click-right": "pavucontrol"
	},

	"network": {
		"interval": 5,
		"format-wifi": "󰤨 {essid}",
		"format-ethernet": "󰈀 {ifname}",
		"format-linked": "󰈀 {ifname} (No IP)",
		"format-disconnected": "󰤭 Disconnected",
		"tooltip-format-wifi": "󰤨 {essid} ({signalStrength}%)\nIP: {ipaddr}",
		"tooltip-format-ethernet": "󰈀 {ifname}\nIP: {ipaddr}",
		"tooltip-format-disconnected": "Disconnected",
		"on-click": "wifi-picker"
	},

	"cpu": {
		"interval": 5,
		"format": " {usage:2}%",
		"tooltip": true
	},

	"memory": {
		"interval": 5,
		"format": "󰍛 {percentage:2}%",
		"tooltip-format": "RAM: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
	},

	"custom/temp": {
		"exec": "waybar-temp",
		"return-type": "json",
		"interval": 5,
		"tooltip": false
	},

	"battery": {
		"states": {
			"good": 95,
			"warning": 30,
			"critical": 15
		},
		"format": "{icon} {capacity}%",
		"format-charging": "󰂄 {capacity}%",
		"format-plugged": "󰚥 {capacity}%",
		"format-alt": "{icon} {time}",
		"format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
	},

	"tray": {
		"icon-size": 14,
		"spacing": 8
	}
}
