# mise configuration - replaces asdf for language runtime management
# https://mise.jdx.dev/configuration.html

[tools]
# Language runtimes (migrated from asdf)
nodejs = "lts"        # Use LTS for stability
ruby = "3.4.7"
python = "3.13"       # Use stable version (3.14 not fully released)

# CLI tools
# Pinned (not "latest"): 0.44.0 has a known endless-resize-flicker/crash bug,
# and 0.45.1 has a fresh (2026-09-27) panic-on-ClosePane report. 0.43.1 predates both.
zellij = "0.43.1"
"npm:tree-sitter-cli" = "latest"
lazygit = "latest"
lazydocker = "latest"
gemini-cli = "latest"
"npm:@doist/todoist-cli" = "latest"
gh = "latest"
{{ if not (has .chezmoi.hostname .hostnames.work) -}}
# Antigravity CLI (Google's terminal coding agent). Personal machines only --
# not put on work Macs by default, that's a policy call to make deliberately.
#
# exe=antigravity: the release tarball ships a single binary named `antigravity`.
# rename_exe=agy:  expose it as `agy`, matching what Google's own install.sh
#                  calls it. Also keeps the name free: the Antigravity IDE is a
#                  separate product whose .deb claims /usr/bin/antigravity, so an
#                  un-renamed shim here would silently shadow its launcher.
#
# Auth note: `agy` stores OAuth creds in the Secret Service (GNOME keyring), so
# on headless boxes it cannot persist a login -- those use GEMINI_API_KEY with
# modelProvider=gemini instead. See ~/.config/zsh/secrets.zsh (untracked).
"github:google-antigravity/antigravity-cli" = { version = "latest", exe = "antigravity", rename_exe = "agy" }
{{- end }}
{{- if has .chezmoi.hostname .hostnames.work }}
sops = "latest"
rust = "latest"
# Gated with rust, not independently: the cargo: backend builds from source and
# needs the toolchain above, so listing it on a host without rust makes
# `mise install` fail rather than skip.
"cargo:flashy" = "latest"
{{- end }}

[settings]
# Enable experimental features if needed
experimental = false

# Verbose output for debugging
verbose = false

[settings.ruby]
compile = false
