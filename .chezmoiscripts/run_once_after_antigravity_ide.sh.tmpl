#!/usr/bin/env bash
{{- if not (and (index .variables "gui") (eq .chezmoi.os "linux")) }}
# Antigravity IDE is an Electron GUI app and this repo only knows how to install
# it from Google's Debian repo. Headless boxes and macOS get nothing here --
# headless machines still get the `agy` CLI via mise, which is the useful half.
exit 0
{{- end }}
# Install the Antigravity IDE (Google's VS Code fork) from the official APT repo.
#
# Deliberately APT rather than a pinned .deb: the repo ships new builds often and
# a plain `apt upgrade` should carry them. Runs `after` so that
# .chezmoiscripts/run_once_before_packages.sh has already put curl, gpg and
# ca-certificates on the box.

set -euo pipefail

KEYRING=/etc/apt/keyrings/antigravity-repo-key.gpg
LIST=/etc/apt/sources.list.d/antigravity.list
REPO=https://us-central1-apt.pkg.dev/projects/antigravity-auto-updater-dev/

# The .deb drops the real launcher here and symlinks /usr/bin/antigravity to it.
# Test the real path rather than the symlink -- less ambiguous than a PATH lookup.
if [ -x /usr/share/antigravity/bin/antigravity ]; then
  echo "Antigravity IDE already installed, skipping."
  exit 0
fi

echo "Installing Antigravity IDE from Google's APT repo..."

sudo install -d -m 0755 /etc/apt/keyrings
curl -fsSL https://us-central1-apt.pkg.dev/doc/repo-signing-key.gpg \
  | sudo gpg --dearmor --yes -o "$KEYRING"
sudo chmod 0644 "$KEYRING"

echo "deb [arch=$(dpkg --print-architecture) signed-by=$KEYRING] $REPO antigravity-debian main" \
  | sudo tee "$LIST" >/dev/null

# Scoped update so an unrelated broken repo can't fail this install.
sudo apt-get update -o Dir::Etc::sourcelist="$LIST" \
                    -o Dir::Etc::sourceparts="-" \
                    -o APT::Get::List-Cleanup="0"
sudo apt-get install -y antigravity

echo "✓ Antigravity IDE installed. Launch with 'antigravity' or from the app launcher."
echo "  The 'agy' CLI is a separate product managed by mise; each needs its own sign-in."
