# Input data for run_onchange_before_brew_bundle.sh.tmpl, not a dotfile target itself
Brewfile

{{ if not .variables.gui -}}
# Headless machines get no desktop config at all.
.config/kitty
.config/ghostty
.config/sway
.config/run_once_before_sway.sh.tmpl
.config/waybar
.local/bin/lock-screen.sh
.local/bin/ronema
.local/bin/start-wlsunset
{{- end }}

{{ if ne .chezmoi.os "linux" -}}
# Wayland-only: sway, waybar, swaylock, wlsunset and an nmcli wrapper. A GUI
# machine can still be a Mac, so these need an OS gate on top of the gui one.
.config/sway
.config/run_once_before_sway.sh.tmpl
.config/waybar
.local/bin/lock-screen.sh
.local/bin/ronema
.local/bin/start-wlsunset
{{- end }}

{{ if ne .chezmoi.os "darwin" -}}
# macOS-only login profile (/opt/homebrew, Obsidian.app)
.zprofile
{{- end }}

{{ if has .chezmoi.hostname .hostnames.personal_remote -}}
# Skip on remote servers
.config/nvim-minimal
{{- end }}

# Work-repo LSP tuning: names internal repo details, dotfiles repo is public
.config/nvim/lua/csw/ccapi.lua

# Personal per-repo Claude notes: infra topology, ports, env var names
.claude/ccapi-local.md

# Shell secrets: tokens/API keys, never tracked (dotfiles repo is public)
.config/zsh/secrets.zsh

{{ if not (has .chezmoi.hostname .hostnames.work) -}}
# Work-only Claude skills (Obsidian work vault, Linear, promptbox team repo).
# The weekly-update skill is deliberately absent here: it names an internal
# repo and a Slack user id, so it is not tracked in this public repo at all.
.claude/skills/career-note
.claude/skills/daily
.claude/skills/flashcard
.claude/skills/people
.claude/skills/sync-to-promptbox

# memwatch diagnoses the compressor/swap kernel panics on the work laptop and
# is driven by a macOS LaunchAgent that only exists there.
bin/memwatch
{{- end }}
