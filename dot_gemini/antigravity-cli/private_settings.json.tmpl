{
  "allowNonWorkspaceAccess": true,
  "artifactReviewPolicy": "always-proceed",
  "colorScheme": "solarized dark",
  "model": "Gemini 4 Argon (Medium)",
  "permissions": {
    "allow": [
      "command(git status)",
      "command(ls)",
      "command(find . -maxdepth 2 -name \"*.md\")",
      "command(grep)"
    ]
  },
  "showTips": false,
  "toolPermission": "always-proceed",
  "trustedWorkspaces": [
    "{{ .chezmoi.homeDir }}/vaults/J\u0026S Notes",
    "{{ .chezmoi.homeDir }}/.config/nvim",
    "{{ .chezmoi.homeDir }}/repos",
    "{{ .chezmoi.homeDir }}/repos/cloudflare-infra",
    "{{ .chezmoi.homeDir }}/docker/soup-mom",
    "{{ .chezmoi.homeDir }}/.local/share/chezmoi",
    "{{ .chezmoi.homeDir }}"
  ]
}
